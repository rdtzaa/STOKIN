<Window x:Class="Stokin.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="STOKIN - Sistem Inventaris Toko" Width="1280" Height="800" MinWidth="960" MinHeight="580" WindowStartupLocation="CenterScreen">
<Grid x:Name="Root"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="#142F3B"><DockPanel Margin="18,26,14,16"><StackPanel DockPanel.Dock="Top"><TextBlock Text="&#9638;  STOKIN" Foreground="White" FontSize="27" FontWeight="Bold" Margin="8,0,0,5"/><TextBlock Text="INVENTARIS TOKO" Foreground="#8DABB6" FontSize="10" Margin="10,0,0,30"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="#2D4955" Margin="5,12"/><TextBlock Text="Satu toko. Semua tercatat." Foreground="#8DABB6" FontSize="11" Margin="8,5"/><Button Content="Keluar akun" Click="Logout" Background="#203E4A" Foreground="#D5E5EB" BorderThickness="0" Margin="0,10,0,0"/></StackPanel>
<ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Navigation}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.NavigateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#D3E1E7" BorderThickness="0" Margin="0,0,0,4" HorizontalContentAlignment="Left" Padding="12,10"><StackPanel Orientation="Horizontal" Width="145"><TextBlock Text="{Binding Icon}" Width="24" FontSize="16"/><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border>
<DockPanel Grid.Column="1"><Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDE5EA" BorderThickness="0,0,0,1" Padding="28,16"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Border Background="#E6F2EF" CornerRadius="15" Padding="12,6"><TextBlock Text="{Binding Identity}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></Border></StackPanel><StackPanel><TextBlock Text="RUANG KERJA TOKO" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Kelola persediaan dengan lebih tenang." FontSize="12" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
<Grid Margin="26,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><Button Content="Muat Ulang" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" VerticalAlignment="Top"/><StackPanel><TextBlock Text="{Binding Title}" FontSize="27" FontWeight="Bold"/><TextBlock Text="{Binding Caption}" Foreground="{StaticResource Muted}" Margin="0,7,0,16"/></StackPanel></DockPanel>
<ItemsControl Grid.Row="1" ItemsSource="{Binding Cards}" Margin="0,0,0,12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.CardCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Width="150" Padding="12,15" Margin="0,0,8,10" Background="White" BorderBrush="#E0E8EB"><StackPanel Width="124"><TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding Value}" FontSize="15" FontWeight="Bold" Margin="0,10,0,7"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<WrapPanel Grid.Row="2" Visibility="{Binding IsProducts,Converter={StaticResource BoolVis}}" Margin="0,0,0,14"><TextBox Width="205" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="Cari SKU atau nama barang" Margin="0,0,8,6"/><ComboBox Width="160" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Margin="0,0,8,6"/><ComboBox Width="110" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}" Margin="0,0,8,6"/><ComboBox Width="100" ItemsSource="{Binding ActiveOptions}" SelectedItem="{Binding Active}" Margin="0,0,8,6"/><Button Content="Cari &amp; Filter" Command="{Binding SearchCommand}"/></WrapPanel>
<StackPanel Grid.Row="3"><ItemsControl ItemsSource="{Binding Actions}" Margin="0,0,0,12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding Command}" Margin="0,0,8,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Message}" Foreground="#A5462D" Margin="0,0,0,8"/><TextBlock Text="Data belum diperbarui. Ringkasan yang masih tampil berasal dari pemuatan sebelumnya." Visibility="{Binding Stale,Converter={StaticResource BoolVis}}" Foreground="#AA6C14" Margin="0,0,0,8"/><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy,Converter={StaticResource BoolVis}}" Margin="0,0,0,10"/></StackPanel>
<Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="White" CornerRadius="8" BorderBrush="#DEE7EB" BorderThickness="1"><Grid><DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" AutoGeneratingColumn="AutoColumn" MouseDoubleClick="OpenRow" Sorting="SortColumn"/><TextBlock Text="Belum ada data untuk ditampilkan. Tambah data atau sesuaikan filter pencarian." Visibility="{Binding IsEmpty,Converter={StaticResource BoolVis}}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30" IsHitTestVisible="False"/></Grid></Border><StackPanel Grid.Row="1" Visibility="{Binding IsDashboard,Converter={StaticResource BoolVis}}" Margin="0,18,0,0"><TextBlock Text="Aktivitas terbaru" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/><DataGrid ItemsSource="{Binding LatestView}" AutoGeneratingColumn="AutoColumn" MaxHeight="155"/></StackPanel></Grid>
<DockPanel Grid.Row="5" Margin="0,15,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Sebelumnya" Command="{Binding PrevCommand}"/><Button Content="Berikutnya" Command="{Binding NextCommand}"/></StackPanel><TextBlock Text="{Binding PageText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
</Grid></DockPanel></Grid></Window>