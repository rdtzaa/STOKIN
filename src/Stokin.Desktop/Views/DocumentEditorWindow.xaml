<Window x:Class="Stokin.Desktop.Views.DocumentEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding Title}" Width="1100" Height="720" MinWidth="850" MinHeight="520" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="24"><StackPanel DockPanel.Dock="Top"><DockPanel><TextBlock Text="{Binding Number}" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="{Binding Title}" FontSize="25" FontWeight="Bold"/></DockPanel><TextBlock Text="Draf belum mengubah stok. Periksa jumlah, alasan, dan biaya sebelum membukukan." Foreground="{StaticResource Muted}" Margin="0,7,0,18"/>
 <Grid IsEnabled="{Binding CanEdit}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Alasan / catatan" Style="{StaticResource Label}"/><TextBox Text="{Binding Reason,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Referensi eksternal (opsional)" Style="{StaticResource Label}"/><TextBox Text="{Binding External,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
 <StackPanel Visibility="{Binding NeedsReference,Converter={StaticResource BoolVis}}" Margin="0,12,0,0"><TextBlock Text="ID dokumen asal yang sudah dibukukan dan memuat barang terkait" Style="{StaticResource Label}"/><TextBox Text="{Binding ReferenceId,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"/></StackPanel>
 <WrapPanel Margin="0,16,0,16" IsEnabled="{Binding CanEdit}"><TextBox Width="185" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="Cari SKU atau nama" Margin="0,0,8,0"/><Button Content="Cari" Command="{Binding SearchCommand}"/><ComboBox Width="310" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" Margin="0,0,8,0"/><Button Content="+ Tambah barang" Command="{Binding AddCommand}"/><Button Content="Hapus baris" Command="{Binding RemoveCommand}"/></WrapPanel></StackPanel>
 <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding Message}" Foreground="#9F4E28" Margin="0,12"/><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy,Converter={StaticResource BoolVis}}"/><WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Muat Pratinjau Saldo" Command="{Binding PreviewCommand}" Visibility="{Binding IsValue,Converter={StaticResource BoolVis}}"/><Button Content="Periksa Hasil" Command="{Binding RecoverCommand}"/><Button Content="Simpan Draf" Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}"/><Button Content="Bukukan" Command="{Binding PostCommand}" Style="{StaticResource Primary}"/></WrapPanel></StackPanel>
 <DataGrid x:Name="LinesGrid" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" AutoGenerateColumns="False" IsReadOnly="False" IsEnabled="{Binding CanEdit}"><DataGrid.Columns>
 <DataGridTextColumn Header="SKU / Barang" Binding="{Binding Name}" Width="2*" MinWidth="260" IsReadOnly="True"/><DataGridTextColumn Header="Jumlah" Binding="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}" Width="80"/>
 <DataGridTextColumn Header="Biaya unit" Binding="{Binding Cost,UpdateSourceTrigger=PropertyChanged}" Width="110"/>
 <DataGridTextColumn Header="Arah IN/OUT" Binding="{Binding Direction,UpdateSourceTrigger=PropertyChanged}" Width="100"/>
 <DataGridTextColumn Header="Target nilai" Binding="{Binding Target,UpdateSourceTrigger=PropertyChanged}" Width="120"/>
 <DataGridTextColumn Header="Dasar perhitungan" Binding="{Binding Basis,UpdateSourceTrigger=PropertyChanged}" Width="200"/>
 <DataGridTextColumn Header="Pratinjau" Binding="{Binding PreviewText}" Width="350" IsReadOnly="True"/>
 </DataGrid.Columns></DataGrid></DockPanel>
</Window>
