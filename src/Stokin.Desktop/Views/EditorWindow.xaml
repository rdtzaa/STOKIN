<Window x:Class="Stokin.Desktop.Views.EditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding Title}" Width="560" Height="680" MinWidth="440" MinHeight="380" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="28"><StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" Margin="0,8,0,20"/></StackPanel>
 <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding Error}" Foreground="#B13D3D" Margin="0,12"/><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy,Converter={StaticResource BoolVis}}" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Batal" Click="Cancel"/><Button Content="Simpan" Command="{Binding SaveCommand}" Style="{StaticResource Primary}" IsDefault="True"/></StackPanel></StackPanel>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,8,16"><TextBlock Text="{Binding Label}" Style="{StaticResource Label}"/>
 <TextBox Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnly}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Secret}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
 <PasswordBox PasswordChanged="PasswordChanged" Visibility="{Binding Secret,Converter={StaticResource BoolVis}}"/>
 <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" Visibility="{Binding IsChoice,Converter={StaticResource BoolVis}}"/>
 <TextBlock Text="{Binding Error}" Foreground="#B13D3D" Margin="0,4,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel>
</Window>
