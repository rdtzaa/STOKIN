<Window x:Class="Stokin.Desktop.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Masuk • STOKIN" Width="480" Height="580" MinHeight="480" ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
 <Border Padding="38" Background="White" Margin="20" CornerRadius="12"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="▦  STOKIN" Foreground="{StaticResource Accent}" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="Heading" Text="Masuk ke toko Anda" FontSize="26" FontWeight="Bold" Margin="0,30,0,8"/><TextBlock x:Name="Description" Text="Gunakan akun pribadi untuk melanjutkan." Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
 <StackPanel x:Name="StorePanel" Visibility="Collapsed"><TextBlock Text="Nama toko" Style="{StaticResource Label}"/><TextBox x:Name="Store" Margin="0,0,0,14"/></StackPanel>
 <TextBlock Text="Nama akun" Style="{StaticResource Label}"/><TextBox x:Name="Username" Margin="0,0,0,14"/><TextBlock Text="Kata sandi" Style="{StaticResource Label}"/><PasswordBox x:Name="Password"/>
 <TextBlock x:Name="Error" Foreground="#B13D3D" Margin="0,14,0,10"/><Button x:Name="LoginButton" Content="Masuk  →" Click="Login" Style="{StaticResource Primary}" IsDefault="True"/><TextBlock Text="Sesi akan terkunci setelah 15 menit tanpa aktivitas." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,20,0,0"/></StackPanel></ScrollViewer></Border>
</Window>
