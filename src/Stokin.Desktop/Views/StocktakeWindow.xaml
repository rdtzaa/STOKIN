<Window x:Class="Stokin.Desktop.Views.StocktakeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Stok Opname • STOKIN" Width="1080" Height="680" MinWidth="800" MinHeight="500" WindowStartupLocation="CenterOwner"><DockPanel Margin="24"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Stok opname" FontSize="26" FontWeight="Bold"/><TextBlock Text="{Binding Title}" Foreground="{StaticResource Accent}" Margin="0,8,0,12"/><TextBlock Text="Isi jumlah fisik dan alasan selisih. Selisih positif pada acuan nol memerlukan biaya unit Admin. Seluruh selisih nol menutup sesi tanpa mutasi." Foreground="{StaticResource Muted}" Margin="0,0,0,18"/></StackPanel>
 <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding Message}" Foreground="#A04C28" Margin="0,14"/><WrapPanel HorizontalAlignment="Right"><Button Content="Muat Ulang Acuan" Command="{Binding ReloadCommand}" Visibility="{Binding Admin,Converter={StaticResource BoolVis}}"/><Button Content="Batalkan Sesi" Command="{Binding CancelCommand}" Visibility="{Binding Admin,Converter={StaticResource BoolVis}}"/><Button Content="Simpan Hitung" Click="SaveClicked" IsEnabled="{Binding Open}"/><Button Content="Tinjau &amp; Bukukan" Click="PostClicked" Style="{StaticResource Primary}" Visibility="{Binding Admin,Converter={StaticResource BoolVis}}"/></WrapPanel><ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0" Visibility="{Binding IsBusy,Converter={StaticResource BoolVis}}"/></StackPanel>
 <DataGrid x:Name="Grid" ItemsSource="{Binding Lines}" AutoGeneratingColumn="AutoColumn" IsReadOnly="False" IsEnabled="{Binding Open}"/></DockPanel></Window>
